{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "packages/ui/src",
    "apps/preview/src",
    "apps/preview/vite.config.ts",
    "vitest.config.ts",
    "packages/ui/tests",
    "scripts/test-setup.ts"
  ]
}
