{
  "name": "polli-design-system",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @polli/preview",
    "build": "npm run build -w @samarinara/polli-ui && npm run registry && npm run build -w @polli/preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "registry": "node scripts/build-registry.mjs",
    "preview:file": "npm run build && node scripts/build-preview-file.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
