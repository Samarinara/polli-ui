{
  "name": "polli-design-system",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @polli/preview",
    "build": "npm run build -w @samarinara/polli-ui && npm run registry && npm run build -w @polli/preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:docs": "playwright test",
    "registry": "node scripts/build-registry.mjs",
    "preview:file": "npm run build && node scripts/build-preview-file.mjs",
    "expo": "npm run start -w @polli/expo",
    "expo:web": "npm run web -w @polli/expo",
    "build:expo": "npm run export -w @polli/expo",
    "typecheck:expo": "tsc -p apps/expo/tsconfig.json --noEmit",
    "test:universal": "vitest run --config vitest.universal.config.ts",
    "test:expo": "playwright test --config playwright.expo.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "react-native": "^0.88.0",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
